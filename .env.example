# DataTrust Audit — backend configuration (copy to .env). All variables are optional.

# Assistant LLM mode (otherwise deterministic, grounded answers)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Abuse protection (public tool: no login, no plan)
DATATRUST_MAX_CONCURRENT_SCANS=2
DATATRUST_RATE_LIMIT_SCANS=12
DATATRUST_RATE_WINDOW_S=600
DATATRUST_DEEP_MAX_PAGES=6

# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For
DATATRUST_TRUST_PROXY=0
DATATRUST_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

LOG_LEVEL=INFO

# NEVER set in production — test-only allow-list for local fixture servers
# DATATRUST_TEST_ALLOW_HOSTS=
