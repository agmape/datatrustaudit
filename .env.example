# -----------------------------
# Core / production
# -----------------------------
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=https://YOUR_PROJECT.vercel.app
VITE_APP_URL=https://YOUR_PROJECT.vercel.app
VITE_API_URL=

# Persistent production database (do NOT use local SQLite on Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
STRICT_EVIDENCE_MODE=true

# Supabase auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Admin testing (keep disabled in production)
DEV_ADMIN_MODE=false
VITE_DEV_ADMIN_MODE=false
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=
ADMIN_TEST_NAME=
VITE_ADMIN_EMAIL=

# Limits
FREE_MAX_SCANS=10
PRO_MAX_SCANS=50
PREMIUM_MAX_SCANS=200

# Payments / checkout
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PRICE_FREE=0
PRICE_PRO_BRL=49.90
PRICE_PREMIUM_BRL=149.90
VITE_KIWIFY_PRO_MONTHLY_URL=
VITE_KIWIFY_PREMIUM_MONTHLY_URL=
VITE_KIWIFY_PRO_YEARLY_URL=
VITE_KIWIFY_PREMIUM_YEARLY_URL=

# PIX / billing display (public frontend values if prefixed VITE_)
PIX_KEY=
PIX_KEY_TYPE=
BANK_NAME=
BANK_SHORT=
BANK_AGENCY=
BANK_ACCOUNT=
BANK_ACCOUNT_TYPE=
BANK_HOLDER=
VITE_PIX_KEY=

# Optional email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=
FROM_EMAIL=
FROM_SUPPORT_EMAIL=
FROM_BILLING_EMAIL=

# Optional queue / worker (not required for basic local execution)
REDIS_URL=
